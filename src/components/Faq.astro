---
import Icon from './Icon.astro';
import { company, faqs } from '../data/site';
---

<section class="section faq" id="questions" aria-labelledby="faq-title">
	<div class="wrap faq__grid">
		<div class="faq__head">
			<p class="label mono"><span>Q</span> Questions</p>
			<h2 class="h2" id="faq-title">Questions about <em>plans and permits.</em></h2>
			<p class="faq__more">Not on the list? Write to the studio and we answer by email.</p>
			<a class="link-arrow" href={`mailto:${company.email}`}>Email the studio <Icon name="arrow-right" /></a>
		</div>
		<div class="faq__list" data-faq>
			{
				faqs.map((f, i) => (
					<details class="qa" open={i < 3}>
						<summary>
							<span class="qa__q">{f.q}</span>
							<span class="qa__icon" aria-hidden="true" />
						</summary>
						<div class="qa__a">
							<p>{f.a}</p>
						</div>
					</details>
				))
			}
		</div>
	</div>
</section>
