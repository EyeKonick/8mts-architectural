---
type Name = 'arrow-right' | 'arrow-up-right' | 'arrow-down' | 'plus' | 'mail' | 'messenger' | 'pin' | 'check';

interface Props {
	name: Name;
	class?: string;
}

const { name, class: className } = Astro.props;

const paths: Record<Name, string> = {
	'arrow-right': 'M2 8h12M9 3l5 5-5 5',
	'arrow-up-right': 'M4 12L12 4M5.5 4H12v6.5',
	'arrow-down': 'M8 2v12M3 9l5 5 5-5',
	plus: 'M8 2v12M2 8h12',
	mail: 'M2 4h12v8H2zM2 4l6 5 6-5',
	messenger: 'M8 2C4.7 2 2 4.5 2 7.6c0 1.8.9 3.3 2.2 4.4V14l2-1.1c.6.2 1.2.3 1.8.3 3.3 0 6-2.5 6-5.6S11.3 2 8 2zM4.8 9.2l2-2.2 1.5 1.3 2-1.3-2 2.2-1.5-1.3z',
	pin: 'M8 14s4.5-4.2 4.5-7.5a4.5 4.5 0 10-9 0C3.5 9.8 8 14 8 14zM8 8a1.5 1.5 0 100-3 1.5 1.5 0 000 3z',
	check: 'M3 8.5l3 3 7-7',
};
---

<svg
	class:list={['icon', className]}
	viewBox="0 0 16 16"
	width="16"
	height="16"
	fill="none"
	stroke="currentColor"
	stroke-width="1.5"
	stroke-linecap="round"
	stroke-linejoin="round"
	aria-hidden="true"
	focusable="false"><path d={paths[name]}></path></svg
>
